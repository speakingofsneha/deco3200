---
// a large serif statement between chapters.
interface Props {
  text: string[];
}
const { text } = Astro.props;
---

<h2 data-reveal class="mx-auto max-w-[36rem] text-center font-serif text-[2rem] leading-[2.375rem] tracking-[-0.01em] text-ink sm:text-[2.25rem] sm:leading-[2.625rem]">
  {text.map((t, i) => <>{i > 0 && <br />}{t}</>)}
</h2>
