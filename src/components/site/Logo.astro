---
// bloom's wordmark: a seed resting on the ground, then the name.
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---

<span class="wordmark" style={`font-size:${size}px`} role="img" aria-label="Bloom">
  <span class="wordmark-seed" aria-hidden="true"></span>
  <span aria-hidden="true">bloom</span>
</span>
