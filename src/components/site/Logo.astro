---
// bloom's mark: five soft petals around a seed.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
const petals = [0, 72, 144, 216, 288];
---

<svg width={size} height={size} viewBox="0 0 32 32" role="img" aria-label="Bloom">
  {petals.map((r) => (
    <ellipse cx="16" cy="9" rx="4.6" ry="7" fill="#111210" transform={`rotate(${r} 16 16)`} opacity="0.92" />
  ))}
  <circle cx="16" cy="16" r="3.2" fill="#faf9f3" />
</svg>
